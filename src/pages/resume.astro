---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

// resume.json のデータを取得
const resumeEntry = await getEntry('resume', 'resume');
const data = resumeEntry?.data || {};

const { experience, education, skills, certifications, learning } = data;
---

<BaseLayout title="Resume — yukassa" description="職務経歴書とスキルセットの詳細">
  <div class="resume-page stack gap-20">
    <header class="resume-header wrapper">
      <h1 class="page-title">Resume</h1>
      <p class="page-lead">
        これまでのキャリア、スキルセット、学習の記録です。
        <br />
        <span class="annotation">※内容はすべてダミーデータに基づいたフィクションです。</span>
      </p>
    </header>

    <main class="wrapper stack gap-20 lg:gap-32">
      
      {/* 職歴セクション */}
      <section class="section">
        <h2 class="section-title">Experience</h2>
        <div class="timeline">
          {(experience || []).map((job) => (
            <div class="timeline-item">
              <div class="timeline-meta">
                <span class="timeline-period">{job.period}</span>
                <span class="timeline-location">{job.location}</span>
              </div>
              <div class="timeline-content">
                <h3 class="timeline-role">{job.role}</h3>
                <h4 class="timeline-company">{job.company}</h4>
                
                {job.highlights && (
                  <ul class="highlight-list">
                    {job.highlights.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* 学歴セクション */}
      <section class="section">
        <h2 class="section-title">Education</h2>
        <div class="timeline">
          {(education || []).map((school) => (
            <div class="timeline-item">
              <div class="timeline-meta">
                <span class="timeline-period">{school.period}</span>
              </div>
              <div class="timeline-content">
                <h3 class="timeline-role">{school.degree}</h3>
                <h4 class="timeline-company">{school.school}</h4>
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* スキルセクション */}
      <section class="section">
        <h2 class="section-title">Skills</h2>
        <div class="skills-grid">
          {(skills || []).map((group) => (
            <div class="skill-group">
              <h3 class="skill-category">{group.category}</h3>
              <div class="skill-tags">
                {group.items.map((skill) => (
                  <div class="skill-tag">
                    <span class="skill-name">{skill.name}</span>
                    {/* スキルレベルをドットで表現 */}
                    <span class="skill-dots" aria-label={`${skill.count} level`}>
                       {/* countの値に応じて透明度を変えるなどの演出も可能ですがシンプルに */}
                       <span style={`opacity: ${Math.min(skill.count / 20, 1)}`}>●</span>
                    </span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* 資格・学習中セクション */}
      <div class="grid-2-col">
        {certifications && (
          <section class="section compact">
            <h2 class="section-title">Certifications</h2>
            <ul class="simple-list">
              {certifications.map((cert) => (
                <li>{cert}</li>
              ))}
            </ul>
          </section>
        )}

        {learning && (
          <section class="section compact">
            <h2 class="section-title">Learning Now</h2>
            <ul class="simple-list">
              {learning.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )}
      </div>

    </main>
  </div>
</BaseLayout>

<style>
  .resume-page {
    padding-bottom: 4rem;
  }

  .resume-header {
    text-align: center;
    padding-top: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--gray-800);
  }

  .page-title {
    font-size: var(--text-4xl);
    color: var(--gray-0);
    margin-bottom: 0.5rem;
  }

  .page-lead {
    color: var(--gray-400);
    font-size: var(--text-lg);
  }

  .annotation {
    font-size: 0.85rem;
    color: var(--gray-500);
  }

  /* セクション共通 */
  .section {
    display: grid;
    gap: 1.5rem;
    align-items: flex-start;
  }

  @media (min-width: 50em) {
    .section {
      grid-template-columns: 180px 1fr;
      gap: 2rem;
    }
    .section.compact {
      grid-template-columns: 1fr;
    }
  }

  .section-title {
    font-size: var(--text-2xl);
    color: var(--accent);
    margin: 0;
    position: sticky;
    top: 2rem;
  }

  /* タイムラインスタイル */
  .timeline {
    display: grid;
    gap: 3rem;
  }

  .timeline-item {
    display: grid;
    gap: 0.5rem;
  }

  @media (min-width: 50em) {
    .timeline-item {
      grid-template-columns: 150px 1fr;
      gap: 2rem;
    }
  }

  .timeline-meta {
    display: flex;
    flex-direction: column;
    font-size: var(--text-sm);
    color: var(--gray-400);
    margin-top: 0.2rem;
  }

  .timeline-period {
    font-weight: 600;
    color: var(--gray-200);
  }

  .timeline-content {
    display: grid;
    gap: 0.5rem;
  }

  .timeline-role {
    font-size: var(--text-xl);
    color: var(--gray-100);
    margin: 0;
  }

  .timeline-company {
    font-size: var(--text-md);
    color: var(--accent);
    margin: 0;
    font-weight: 500;
  }

  .highlight-list {
    margin-top: 0.5rem;
    padding-left: 1.2rem;
    color: var(--gray-300);
    line-height: 1.6;
  }

  /* スキルグリッド */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
  }

  .skill-category {
    font-size: var(--text-lg);
    color: var(--gray-200);
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--gray-800);
    padding-bottom: 0.5rem;
  }

  .skill-tags {
    display: grid;
    gap: 0.5rem;
  }

  .skill-tag {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255,255,255,0.03);
    padding: 0.5rem 0.8rem;
    border-radius: 6px;
    font-size: 0.95rem;
    color: var(--gray-300);
  }
  
  .skill-dots {
    color: var(--accent);
    font-size: 0.8rem;
  }

  /* 2カラムレイアウト（資格・学習） */
  .grid-2-col {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 50em) {
    .grid-2-col {
      grid-template-columns: 1fr 1fr;
      padding-left: calc(180px + 2rem); /* Section title分のインデント */
    }
  }

  .simple-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.8rem;
  }

  .simple-list li {
    padding-left: 1.2rem;
    position: relative;
    color: var(--gray-300);
  }

  .simple-list li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: var(--accent);
  }
</style>
