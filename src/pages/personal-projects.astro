---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// 'personal' タイプのプロジェクトのみ取得
const allProjects = await getCollection('projects');
const personalProjects = allProjects
  .filter(p => p.data.projectType === 'personal')
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
---

<BaseLayout title="Personal Projects | yukassa" description="物理シミュレーションとコードの実験室">
  <div class="wrapper">
    <header class="page-header">
      <a href="/" class="back-link">← Back to Home</a>
      <h1>Personal Projects</h1>
      <p class="lead">
        物理学のバックグラウンドを活かしたアルゴリズムの実装や、個人的な興味に基づく実験的なプロジェクトのコレクションです。
      </p>
    </header>

    <div class="projects-grid">
      {/* プロジェクトがある場合 */}
      {personalProjects.length > 0 ? (
        personalProjects.map((project) => (
          <article class="project-card">
            <a href={`/projects/${project.slug}`} class="card-link">
              <span class="sr-only">View {project.data.name}</span>
            </a>
            <h3>{project.data.name}</h3>
            <p>{project.data.summary}</p>
            <div class="tech-stack">
              {project.data.technologies.map(t => <span>{t}</span>)}
            </div>
          </article>
        ))
      ) : (
        /* プロジェクトがない場合 (現状) */
        <div class="empty-state">
          <div class="icon">🚧</div>
          <h3>Under Construction</h3>
          <p>現在、過去に作成した物理シミュレーション（Boidモデルなど）の移行準備中です。</p>
          <div class="upcoming-list">
            <h4>Upcoming:</h4>
            <ul>
              <li>Boid Flocking Simulation (Go/Wasm)</li>
              <li>Cellular Automaton Visualizer</li>
            </ul>
          </div>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .wrapper { max-width: 1000px; margin: 0 auto; padding: 3rem clamp(1.5rem, 5vw, 4rem); }
  
  .back-link { display: inline-block; margin-bottom: 2rem; color: var(--muted); text-decoration: none; }
  .back-link:hover { color: var(--accent); }

  .page-header { margin-bottom: 4rem; }
  .page-header h1 { font-size: 2.5rem; margin-bottom: 1rem; color: var(--text); }
  .lead { color: var(--muted); max-width: 600px; line-height: 1.7; }

  /* Grid Layout */
  .projects-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem; }

  /* Card Style (簡易版) */
  .project-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    position: relative;
    transition: transform 0.2s;
  }
  .project-card:hover { transform: translateY(-4px); border-color: var(--accent); }
  .project-card h3 { margin: 0 0 1rem; color: var(--text); }
  .project-card p { color: var(--muted); font-size: 0.95rem; margin-bottom: 1.5rem; }
  .tech-stack { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .tech-stack span { font-size: 0.8rem; background: rgba(255,255,255,0.05); padding: 0.2rem 0.6rem; border-radius: 4px; color: var(--muted); }
  
  .card-link { position: absolute; inset: 0; z-index: 1; }

  /* Empty State */
  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 4rem 2rem;
    background: rgba(255,255,255,0.02);
    border-radius: var(--radius-lg);
    border: 1px dashed var(--border);
  }
  .empty-state .icon { font-size: 3rem; margin-bottom: 1rem; }
  .empty-state h3 { font-size: 1.5rem; margin-bottom: 1rem; }
  .upcoming-list { margin-top: 2rem; display: inline-block; text-align: left; }
  .upcoming-list h4 { color: var(--accent); font-size: 0.9rem; margin-bottom: 0.5rem; text-transform: uppercase; }
  .upcoming-list ul { color: var(--muted); }
</style>
