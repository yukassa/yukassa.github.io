---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, getCollection } from 'astro:content';

// 1. 基本情報・学歴・職歴・興味は引き続き resume.json から取得
const resumeEntry = await getEntry('resume', 'resume');
const data = resumeEntry?.data || {};
const education = data.education || [];
const workHistory = data.work || [];
const interests = data.interests || [];

// 2. プロジェクト情報は MDX (content collections) から取得
const allProjects = await getCollection('projects');

// 'work' (Key Projects) と 'personal' (Personal Lab) に分類
// ※ MDXの frontmatter に projectType: "work" または "personal" が必要です
const keyProjects = allProjects.filter(p => p.data.projectType === 'work');
const personalLab = allProjects.filter(p => p.data.projectType === 'personal');
---

<BaseLayout title="Portfolio" description={data.basics?.summary}>
  <div class="stack gap-20 lg:gap-32">
    
    {/* 1. Hero: 何者かを端的に */}
    <header class="hero wrapper">
      <h1 class="hero-title">
        Backend Engineer <br/>
        <span class="text-accent">x Physics Background</span>
      </h1>
      <p class="hero-lead">
        {data.basics?.summary}
      </p>
      <div class="hero-tags">
        <span>Backend (7 years)</span>
        <span>M.Sc. in Biophysics</span>
        <span>Python / Go</span>
      </div>
    </header>

    {/* 2. Background: 学術的背景とキャリアの流れ */}
    <section class="section wrapper">
      <h2 class="section-title">Background</h2>
      <div class="timeline">
        {/* 学歴 */}
        <div class="timeline-group">
          <h3>Academic</h3>
          <ul class="timeline-list">
            {education.map((edu) => (
              <li>
                <span class="year">{edu.period}</span>
                <div class="content">
                  <strong>{edu.area} <span class="degree-badge">{edu.studyType}</span></strong>
                  <p>{edu.summary}</p>
                  
                  {/* 学歴のリンク表示 */}
                  {edu.links && edu.links.length > 0 && (
                    <div class="edu-links">
                      {edu.links.map(link => (
                        <a href={link.url} target="_blank" rel="noopener noreferrer" class="text-link">
                          <span class="icon">📎</span> {link.label}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
        {/* 職歴 */}
        <div class="timeline-group">
          <h3>Career</h3>
          <ul class="timeline-list">
            {workHistory.map((job) => (
              <li>
                <span class="year">{job.period}</span>
                <div class="content">
                  <strong>{job.position}</strong>
                  <p>{job.summary}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {/* 3. Key Projects: 主要な業務実績3選 (MDXから取得) */}
    {keyProjects.length > 0 && (
      <section class="section wrapper">
        <h2 class="section-title">Key Projects</h2>
        <p class="section-desc">バックエンドエンジニアとしての主要なシステム開発・データ分析の実績です。</p>
        
        <div id="key-projects" class="projects-grid">
          {keyProjects.map((project) => (
            // MDXコレクションの場合、slugは自動生成されたファイル名等になります
            <a href={`/projects/${project.slug}`} class="card-link">
              <article class="project-card">
                <header class="card-header">
                  <h3>{project.data.name}</h3>
                  <span class="tech-tag">{project.data.architecture}</span>
                </header>
                
                <p class="project-summary">{project.data.summary}</p>
                
                {/* 関連リンク（TechBook等）があれば表示 */}
                {project.data.relatedLink && (
                  <div class="related-link-wrapper">
                    <span class="text-link">
                      <span class="icon">📎</span> {project.data.relatedLink.label}
                    </span>
                  </div>
                )}

                <div class="card-footer">
                   <span class="tech-stack">{project.data.technologies?.join(', ')}</span>
                   <span class="arrow-icon">→</span>
                </div>
              </article>
            </a>
          ))}
        </div>
      </section>
    )}

    {/* 4. Personal Lab: ポテンシャルを示す個人開発 (MDXから取得) */}
    {personalLab.length > 0 && (
      <section class="section wrapper bg-accent-subtle">
        <h2 class="section-title">Personal Lab</h2>
        <p class="section-desc">物理シミュレーション・数理モデルへの関心に基づく個人的な取り組み。</p>
        
        <div class="lab-grid">
          {personalLab.map((lab) => (
            <a href={`/projects/${lab.slug}`} class="card-link lab-link-wrapper">
              <article class="lab-card">
                <div class="lab-content">
                    {lab.data.architecture && (
                      <span class="tech-tag lab-tag">{lab.data.architecture}</span>
                    )}
                    <h3>{lab.data.name}</h3>
                    <p>{lab.data.summary}</p>
                    {/* MDX化に伴い詳細リスト(li)は削除し、詳細ページで見せる設計に変更 */}
                    
                    <div class="lab-techs">
                      <strong>Tech Stack:</strong> {lab.data.technologies?.join(', ')}
                    </div>
                </div>
                <div class="lab-visual">
                    <div class="placeholder-img">
                      <span>Simulation<br/>Demo / Image</span>
                    </div>
                </div>
              </article>
            </a>
          ))}
        </div>
      </section>
    )}

    {/* 5. Interests */}
    <section class="section wrapper text-center">
      <h2 class="section-title-sm">Interests</h2>
      <div class="interests-cloud">
        {interests.map((interest) => (
          <span>{interest}</span>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  /* 全体のレイアウト調整 */
  .wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  
  .text-accent { color: var(--accent); }
  .bg-accent-subtle { 
    background: rgba(var(--accent-rgb), 0.05); 
    padding-top: 3rem; 
    padding-bottom: 3rem;
    border-radius: 1rem;
    margin-top: 2rem;
  }

  /* Hero */
  .hero { text-align: center; padding: 4rem 0; }
  .hero-title { font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.1; margin-bottom: 1.5rem; color: var(--gray-0); }
  .hero-lead { color: var(--gray-300); max-width: 680px; margin: 0 auto 2rem; font-size: 1.05rem; line-height: 1.75; }
  .hero-tags { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .hero-tags span { border: 1px solid var(--gray-600); padding: 0.4rem 1rem; border-radius: 2rem; font-size: 0.9rem; color: var(--gray-200); background: rgba(255,255,255,0.05); }

  /* Section Common */
  .section-title { font-size: 2rem; margin-bottom: 1rem; color: var(--gray-0); text-align: center; }
  .section-title-sm { font-size: 1.2rem; color: var(--gray-400); margin-bottom: 1.5rem; }
  .section-desc { text-align: center; margin-bottom: 3rem; color: var(--gray-400); max-width: 600px; margin-left: auto; margin-right: auto; line-height: 1.75; }

  /* Timeline (Background) */
  .timeline { display: grid; gap: 3rem; margin-top: 2rem; }
  @media (min-width: 768px) { .timeline { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  .timeline-group h3 { color: var(--accent); margin-bottom: 1.5rem; border-bottom: 1px solid var(--gray-700); padding-bottom: 0.5rem; font-size: 1.2rem; letter-spacing: 0.05em; }
  .timeline-list { list-style: none; padding: 0; }
  .timeline-list li { margin-bottom: 2rem; }
  .year { display: block; font-size: 0.85rem; color: var(--gray-500); margin-bottom: 0.3rem; font-family: var(--font-mono); }
  .content strong { display: block; font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--gray-100); }
  .degree-badge { font-size: 0.75em; background: var(--gray-800); padding: 0.1rem 0.4rem; border-radius: 4px; margin-left: 0.3rem; vertical-align: middle; color: var(--gray-300); font-weight: normal; }
  .content p { font-size: 0.95rem; color: var(--gray-400); line-height: 1.75; }

  /* --- Link Styles (Shared) --- */
  .edu-links {
    margin-top: 0.5rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  
  .text-link {
    font-size: 0.85rem;
    color: var(--accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: opacity 0.2s;
  }
  .text-link:hover { opacity: 0.8; text-decoration: underline; }
  .text-link .icon { font-size: 0.8rem; }

  /* カード内のリンク用ラッパー */
  .related-link-wrapper {
    margin-top: 0.5rem;
    margin-bottom: auto; /* フッターとの距離を調整 */
  }

  /* --- Project Cards (Layout Fixed) --- */
  .projects-grid { 
    display: grid; 
    gap: 2rem; 
    align-items: start;
  }
  
  .card-link { text-decoration: none; color: inherit; display: block; height: 100%; }
  
  .project-card { 
    border: 1px solid var(--gray-800); 
    padding: 2rem; 
    border-radius: 1rem; 
    background: var(--gray-999); 
    transition: all 0.3s ease; 
    height: auto; 
    display: flex; 
    flex-direction: column; 
    justify-content: flex-start;
    gap: 0;
    position: relative; 
  }

  .project-card:hover { 
    border-color: var(--accent); 
    transform: translateY(-5px); 
    background: rgba(56, 189, 248, 0.1); 
    box-shadow: 0 12px 40px -12px rgba(56, 189, 248, 0.5);
    cursor: pointer; 
  }

  .card-header { 
    display: flex; 
    justify-content: space-between; 
    align-items: baseline; 
    margin-bottom: 1rem; 
    flex-wrap: wrap; 
    gap: 1rem; 
    flex-grow: 0;
  }
  .card-header h3 { font-size: 1.4rem; color: var(--gray-100); margin: 0; transition: color 0.3s ease; }
  .card-link:hover h3 { color: var(--accent); }

  .project-summary { 
    flex-grow: 0; 
    margin-bottom: 1.5rem; 
    color: var(--gray-300);
    line-height: 1.75; 
  }
  
  /* カードフッター */
  .card-footer { 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    margin-top: 1.5rem; 
    flex-grow: 0;
    gap: 1rem;
  }
  
  .tech-tag { color: var(--accent); font-size: 0.85rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.05em; }
  .tech-stack { font-size: 0.85rem; color: var(--gray-500); font-family: var(--font-mono); }
  
  .arrow-icon { color: var(--accent); font-weight: bold; opacity: 0.5; transform: translateX(0); transition: all 0.3s ease; }
  .card-link:hover .arrow-icon { opacity: 1; transform: translateX(5px); text-shadow: 0 0 8px var(--accent); }


  /* Lab Card */
  .lab-grid { display: flex; flex-direction: column; gap: 2rem;}
  .lab-card { display: grid; gap: 2rem; align-items: center; border: 1px solid var(--gray-800); padding: 2rem; border-radius: 1rem; background: var(--gray-999); transition: all 0.3s ease; position: relative;}
  @media (min-width: 768px) { .lab-card { grid-template-columns: 1.5fr 1fr; } }
  .lab-content h3 { font-size: 1.6rem; margin-bottom: 1rem; color: var(--gray-100); transition: color 0.3s ease;}
  .lab-content p { color: var(--gray-300); line-height: 1.75; margin-bottom: 1rem; }
  .lab-techs { font-size: 0.9rem; color: var(--gray-400); font-family: var(--font-mono); }
  
  /* Labカードのホバー演出 */
  .lab-link-wrapper:hover .lab-card { border-color: var(--accent); transform: translateY(-5px); background: rgba(56, 189, 248, 0.1); box-shadow: 0 12px 40px -12px rgba(56, 189, 248, 0.5); cursor: pointer; }
  .lab-link-wrapper:hover h3 { color: var(--accent); }
  
  .lab-tag { display: block; margin-bottom: 0.5rem; font-size: 0.85rem; }
  .placeholder-img { background: rgba(0,0,0,0.3); border: 1px dashed var(--gray-600); height: 220px; display: flex; align-items: center; justify-content: center; border-radius: 0.5rem; color: var(--gray-400); text-align: center; line-height: 1.4; }

  /* Interests */
  .interests-cloud { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; max-width: 700px; margin: 0 auto; }
  .interests-cloud span { color: var(--gray-200); font-weight: 500; background: rgba(255,255,255,0.05); padding: 0.5rem 1rem; border-radius: 99px; font-size: 0.95rem; }
</style>