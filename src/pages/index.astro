---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const resumeEntry = await getEntry('resume', 'resume');
const data = resumeEntry?.data || {};

// JSONデータの取得
const education = data.education || [];
const workHistory = data.work || [];
const keyProjects = data.keyProjects || []; // 仕事の主要3プロジェクト
const personalLab = data.personalProjects || []; // 個人開発（避難シミュレーション）
const interests = data.interests || [];
---

<BaseLayout title="Portfolio" description={data.basics?.summary}>
  <div class="main-stack">
    
    {/* 1. Hero: 何者かを端的に */}
    <header class="hero wrapper">
      <h1 class="hero-title">
        Backend Engineer <br/>
        <span class="text-accent">x Physics Background</span>
      </h1>
      <p class="hero-lead">
        {data.basics?.summary}
      </p>
    </header>

    {/* 2. Background: カードデザインに変更 */}
    <section class="section wrapper">
      <h2 class="section-title">Background</h2>
      <div class="timeline">
        
        {/* Academic Card */}
        <div class="background-card">
          <h3 class="card-heading">Academic</h3>
          <ul class="timeline-list">
            {education.map((edu) => (
              <li>
                <span class="year">{edu.period}</span>
                <div class="content">
                  <strong>{edu.area} <span class="degree-badge">{edu.studyType}</span></strong>
                  <p>{edu.summary}</p>
                  
                  {/* 学歴のリンク表示 */}
                  {edu.links && edu.links.length > 0 && (
                    <div class="edu-links">
                      {edu.links.map(link => (
                        <a href={link.url} target="_blank" rel="noopener noreferrer" class="text-link">
                          <span class="icon">📎</span> {link.label}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>

        {/* Career Card */}
        <div class="background-card">
          <h3 class="card-heading">Career</h3>
          <ul class="timeline-list">
            {workHistory.map((job) => (
              <li>
                <span class="year">{job.period}</span>
                <div class="content">
                  <strong>{job.position}</strong>
                  <p>{job.summary}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </section>

    {/* 3. Key Projects: 主要な業務実績3選 */}
    <section class="section wrapper">
      <h2 class="section-title">Key Projects</h2>
      <p class="section-desc">バックエンドエンジニアとしての主要なシステム開発・データ分析の実績です。</p>
      
      <div id="key-projects" class="projects-grid">
        {keyProjects.map((project) => {
          // 詳細ページへのリンク生成
          const slug = project.name.toLowerCase().replace(/_/g, '-').replace(/\s+/g, '-');
          
          return (
            <a href={`/projects/${slug}`} class="card-link">
              <article class="project-card">
                <header class="card-header">
                  <h3>{project.name}</h3>
                  <span class="tech-tag">{project.architecture}</span>
                </header>
                <p class="project-summary">{project.summary}</p>
                <ul class="project-points">
                  {project.details?.slice(0, 2).map(d => <li>{d}</li>)}
                  
                  {/* TechBook等のリンク */}
                  {project.relatedLink && (
                    <li class="related-link-item">
                      <a href={project.relatedLink.url} target="_blank" rel="noopener noreferrer" class="text-link">
                        <span class="icon">📎</span> {project.relatedLink.label}
                      </a>
                    </li>
                  )}

                  {/* 詳細がまだあることを示す */}
                  {(project.details?.length || 0) > 2 && <li class="more-points">...View more details</li>}
                </ul>
                <div class="card-footer">
                   <span class="tech-stack">{project.technologies?.join(', ')}</span>
                   <span class="arrow-icon">→</span>
                </div>
              </article>
            </a>
          );
        })}
      </div>
    </section>

    {/* 5. Interests */}
    <section class="section wrapper text-center">
      <h2 class="section-title-sm">Interests</h2>
      <div class="interests-cloud">
        {interests.map((interest) => (
          <span>{interest}</span>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  /* 全体のレイアウト調整 */
  /* ★修正: 全体の垂直方向の間隔をさらに縮小 */
  .main-stack {
    display: flex;
    flex-direction: column;
    gap: 1.5rem; /* 2rem -> 1.5rem (スマホでの密度アップ) */
  }
  @media (min-width: 768px) {
    .main-stack {
      gap: 2.5rem; /* 3.5rem -> 2.5rem (PCでも間延び防止) */
    }
  }

  .wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  
  .text-accent { color: var(--accent); }
  .bg-accent-subtle { 
    background: rgba(var(--accent-rgb), 0.05); 
    padding-top: 3rem; 
    padding-bottom: 3rem;
    border-radius: 1rem;
    margin-top: 2rem;
  }

  /* Hero */
  .hero { text-align: center; padding: 1.5rem 0; }
  .hero-title { font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.1; margin-bottom: 1.5rem; color: var(--gray-0); }
  
  .hero-lead { 
    color: var(--gray-300); 
    width: 90%;          
    max-width: 600px;    
    margin: 0 auto 0.5rem;
    font-size: 1.05rem; 
    line-height: 1.75; 
  }
  @media (min-width: 768px) {
    .hero-lead {
      width: 100%;       
      max-width: 800px;  
    }
  }

  /* --- Section Title --- */
  .section-title { 
    font-size: 2rem; 
    margin-bottom: 0.5rem; 
    color: var(--gray-0); 
    text-align: left; 
    border-top: 1px solid var(--gray-600);
    
    /* ★修正: 上線の余白をさらに縮小 (1rem -> 0.5rem) */
    padding-top: 0.5rem;    
    
    width: 100%;
  }

  .section-title-sm { font-size: 1.2rem; color: var(--gray-400); margin-bottom: 1.5rem; }
  
  .section-desc { 
    text-align: left; 
    
    /* ★修正: 説明文下の余白をさらに縮小 (1rem -> 0.75rem) */
    margin-bottom: 0.75rem; 
    
    color: var(--gray-400); 
    max-width: 600px; 
    line-height: 1.75; 
  }

  /* --- Background Section (Card Design) --- */
  /* ★修正: グリッド間隔を縮小 (1rem -> 0.75rem) これでスマホのAcademic/Careerの間が狭まります */
  .timeline { display: grid; gap: 0.75rem; margin-top: 0; }
  @media (min-width: 768px) { .timeline { grid-template-columns: 1fr 1fr; } }

  .background-card {
    border: 1px solid var(--gray-800); 
    
    /* ★修正: カード内パディングを少し縮小 (1.5rem -> 1.25rem) */
    padding: 1.25rem; 
    
    border-radius: 1rem; 
    background: var(--gray-999); 
    height: 100%; 
    display: flex;
    flex-direction: column;
  }

  /* カード内の見出し */
  .card-heading { 
    color: var(--accent);     
    margin-bottom: 0.8rem; 
    border-bottom: 1px solid var(--gray-700); 
    padding-bottom: 0.5rem; 
    font-size: 1.2rem; 
    letter-spacing: 0.05em; 
  }

  .timeline-list { list-style: none; padding: 0; }
  .timeline-list li { margin-bottom: 1rem; }
  .timeline-list li:last-child { margin-bottom: 0; }

  .year { display: block; font-size: 0.85rem; color: var(--gray-500); margin-bottom: 0.2rem; font-family: var(--font-mono); }
  .content strong { display: block; font-size: 1.1rem; margin-bottom: 0.3rem; color: var(--gray-100); }
  .degree-badge { font-size: 0.75em; background: var(--gray-800); padding: 0.1rem 0.4rem; border-radius: 4px; margin-left: 0.3rem; vertical-align: middle; color: var(--gray-300); font-weight: normal; }
  .content p { font-size: 0.95rem; color: var(--gray-400); line-height: 1.75; margin-bottom: 0.5rem; }

  /* --- Link Styles (Shared) --- */
  .edu-links { margin-top: 0.5rem; display: flex; gap: 1rem; flex-wrap: wrap; }
  .text-link { font-size: 0.85rem; color: var(--accent); text-decoration: none; display: inline-flex; align-items: center; gap: 0.3rem; transition: opacity 0.2s; }
  .text-link:hover { opacity: 0.8; text-decoration: underline; }
  .text-link .icon { font-size: 0.8rem; }
  .related-link-item { list-style: none; margin-top: 0.6rem; margin-left: -1.2rem; }

  /* --- Project Cards --- */
  /* ★修正: Gapを縮小 */
  .projects-grid { 
    display: grid; 
    gap: 1.25rem; /* 1.5rem -> 1.25rem */
    align-items: start;
  }
  
  .card-link { text-decoration: none; color: inherit; display: block; height: 100%; }
  
  .project-card { 
    border: 1px solid var(--gray-800); 
    
    /* ★修正: パディングを縮小 (1.5rem -> 1.25rem) */
    padding: 1.25rem; 
    
    border-radius: 1rem; 
    background: var(--gray-999); 
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    height: auto; 
    display: flex; 
    flex-direction: column; 
    justify-content: flex-start;
    gap: 0;
    position: relative; 
  }

  .card-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.8rem; flex-wrap: wrap; gap: 1rem; flex-grow: 0; }
  .card-header h3 { font-size: 1.4rem; color: var(--gray-100); margin: 0; transition: color 0.3s ease; }
  
  .project-summary { flex-grow: 0; margin-bottom: 1rem; color: var(--gray-300); line-height: 1.75; }
  .project-points { flex-grow: 0; padding-left: 1.2rem; margin-bottom: 0; margin-top: 0; color: var(--gray-400); list-style-type: square; line-height: 1.6; }
  .project-points li { margin-bottom: 0.4rem; }
  .more-points { color: var(--accent); font-size: 0.85rem; list-style: none; margin-top: 0.5rem; }
  .card-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 1.5rem; flex-grow: 0; gap: 1rem; }
  .tech-tag { color: var(--accent); font-size: 0.85rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.05em; }
  .tech-stack { font-size: 0.85rem; color: var(--gray-500); font-family: var(--font-mono); }
  
  .arrow-icon { color: var(--accent); font-weight: bold; transform: translateX(0); transition: all 0.3s ease; }

  /* --- Device Behaviors --- */

  /* PC */
  @media (hover: hover) {
    .project-card:hover { 
      border-color: var(--accent); 
      transform: translateY(-5px); 
      background: rgba(56, 189, 248, 0.1); 
      box-shadow: 0 12px 40px -12px rgba(56, 189, 248, 0.5);
      cursor: pointer; 
    }
    .arrow-icon { opacity: 0.5; }
    .card-link:hover .arrow-icon { opacity: 1; transform: translateX(5px); text-shadow: 0 0 8px var(--accent); }
    .card-link:hover h3 { color: var(--accent); }
  }

  /* Mobile */
  @media (hover: none) {
    .arrow-icon { opacity: 1; }
    .card-link:active .project-card {
      background: rgba(56, 189, 248, 0.1);
      border-color: var(--accent);
      transform: scale(0.98);
    }
    .card-link:active h3 { color: var(--accent); }
  }


  /* Lab Card (Styles preserved for future use) */
  .lab-grid { display: flex; flex-direction: column; gap: 2rem;}
  .lab-card { display: grid; gap: 2rem; align-items: center; border: 1px solid var(--gray-800); padding: 2rem; border-radius: 1rem; background: var(--gray-999); transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1); position: relative;}
  @media (min-width: 768px) { .lab-card { grid-template-columns: 1.5fr 1fr; } }
  .lab-content h3 { font-size: 1.6rem; margin-bottom: 1rem; color: var(--gray-100); transition: color 0.3s ease;}
  .lab-content p { color: var(--gray-300); line-height: 1.75; margin-bottom: 1rem; }
  .lab-techs { font-size: 0.9rem; color: var(--gray-400); font-family: var(--font-mono); }
  .lab-tag { display: block; margin-bottom: 0.5rem; font-size: 0.85rem; }
  .placeholder-img { background: rgba(0,0,0,0.3); border: 1px dashed var(--gray-600); height: 220px; display: flex; align-items: center; justify-content: center; border-radius: 0.5rem; color: var(--gray-400); text-align: center; line-height: 1.4; }
  @media (hover: hover) {
    .lab-link-wrapper:hover .lab-card { border-color: var(--accent); transform: translateY(-5px); background: rgba(56, 189, 248, 0.1); box-shadow: 0 12px 40px -12px rgba(56, 189, 248, 0.5); cursor: pointer; }
    .lab-link-wrapper:hover h3 { color: var(--accent); }
  }
  @media (hover: none) {
    .lab-link-wrapper:active .lab-card { background: rgba(56, 189, 248, 0.1); border-color: var(--accent); transform: scale(0.98); }
    .lab-link-wrapper:active h3 { color: var(--accent); }
  }

  /* Interests */
  .interests-cloud { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; max-width: 700px; margin: 0 auto; }
  .interests-cloud span { color: var(--gray-200); font-weight: 500; background: rgba(255,255,255,0.05); padding: 0.5rem 1rem; border-radius: 99px; font-size: 0.95rem; }
</style>
