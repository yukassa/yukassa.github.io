---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, getCollection } from 'astro:content';

// 1. 基本情報・学歴・職歴・興味は resume.json から取得
const resumeEntry = await getEntry('resume', 'resume');
const data = resumeEntry?.data || {};
const education = data.education || [];
const workHistory = data.work || [];
const interests = data.interests || [];

// 2. プロジェクト情報は MDX (content collections) から取得
const allProjects = await getCollection('projects');

// work (Key Projects) と personal (Personal Lab) に振り分け
// order の番号順（昇順: 1 -> 2 -> 3...）に並び替える
const sortedProjects = allProjects.sort((a, b) => {
  // orderが設定されていない場合は後ろ(99)に回す処理
  return (a.data.order ?? 99) - (b.data.order ?? 99);
});

// allProjects ではなく、並び替えた sortedProjects を使って振り分ける
const keyProjects = sortedProjects.filter(p => p.data.projectType === 'work');
const personalLab = sortedProjects.filter(p => p.data.projectType === 'personal');
---

<BaseLayout title="Portfolio" description={data.basics?.summary}>
  <div class="main-stack">
    
    {/* 1. Hero: 何者かを端的に */}
    <header class="hero wrapper">
      <h1 class="hero-title">
        Backend Engineer <br/>
        <span class="text-accent">x Physics Background</span>
      </h1>
      <p class="hero-lead">
        {data.basics?.summary}
      </p>
    </header>

    {/* 2. Background: カードデザインに変更 */}
    <section class="section wrapper">
      <h2 class="section-title">Background</h2>
      <div class="timeline">
        
        {/* Academic Card */}
        <div class="background-card">
          <h3 class="card-heading">Academic</h3>
          <ul class="timeline-list">
            {education.map((edu) => (
              <li>
                <span class="year">{edu.period}</span>
                <div class="content">
                  <strong>{edu.area} <span class="degree-badge">{edu.studyType}</span></strong>
                  <p>{edu.summary}</p>
                  
                  {/* 学歴のリンク表示 */}
                  {edu.links && edu.links.length > 0 && (
                    <div class="edu-links">
                      {edu.links.map(link => (
                        <a href={link.url} target="_blank" rel="noopener noreferrer" class="text-link">
                          <span class="icon">📎</span> {link.label}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>

        {/* Career Card */}
        <div class="background-card">
          <h3 class="card-heading">Career</h3>
          <ul class="timeline-list">
            {workHistory.map((job) => (
              <li>
                <span class="year">{job.period}</span>
                <div class="content">
                  <strong>{job.position}</strong>
                  <p>{job.summary}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </section>

    {/* 3. Key Projects (MDXから取得) */}
    <section class="section wrapper">
      <h2 class="section-title">Key Projects</h2>
      <p class="section-desc">バックエンドエンジニアとしての主要なシステム開発・データ分析の実績です。</p>
      
      <div id="key-projects" class="projects-grid">
        {keyProjects.map((project) => (
          <a href={`/projects/${project.slug}`} class="card-link">
            <article class="project-card">
              <header class="card-header">
                <h3>{project.data.name}</h3>
                <span class="tech-tag">{project.data.architecture}</span>
              </header>
              <p class="project-summary">{project.data.summary}</p>
              
              {/* MDX化に伴い、詳細は詳細ページで見せるためリストは削除 */}
              {/* 関連リンク */}
              {project.data.relatedLink && (
                <div class="related-link-wrapper">
                  <span class="text-link">
                    <span class="icon">📎</span> {project.data.relatedLink.label}
                  </span>
                </div>
              )}

              <div class="card-footer">
                 <span class="tech-stack">{project.data.technologies?.join(', ')}</span>
                 <span class="arrow-icon">→</span>
              </div>
            </article>
          </a>
        ))}
      </div>
    </section>

    {/* 5. Interests */}
    <section class="section wrapper text-center">
      <h2 class="section-title-sm">Interests</h2>
      <div class="interests-cloud">
        {interests.map((interest) => (
          <span>{interest}</span>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>


<style>
  /* --- Layout & Spacing --- */
  .main-stack {
    display: flex;
    flex-direction: column;
    gap: 2rem; /* スマホ: 狭め */
  }
  @media (min-width: 768px) {
    .main-stack {
      gap: 3rem; /* PC */
    }
  }

  .wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  
  .text-accent { color: var(--accent); }
  .bg-accent-subtle { 
    background: rgba(var(--accent-rgb), 0.05); 
    padding-top: 3rem; 
    padding-bottom: 3rem;
    border-radius: 1rem;
    margin-top: 2rem;
  }

  /* --- Hero --- */
  .hero { text-align: center; padding: 1rem 0; }
  .hero-title { font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.1; margin-bottom: 1rem; color: var(--gray-0); }
  
  .hero-lead { 
    color: var(--gray-300); 
    width: 90%;          
    max-width: 600px;    
    margin: 0 auto 0.5rem;
    font-size: 1.05rem; 
    line-height: 1.6; 
  }
  @media (min-width: 768px) {
    .hero-lead {
      width: 100%;       
      max-width: 800px;  
    }
  }

  /* --- Section Title --- */
  .section-title { 
    font-size: 2rem; 
    margin-bottom: 0.5rem; 
    color: var(--gray-0); 
    text-align: left; 
    border-top: 1px solid var(--gray-600);
    padding-top: 0.75rem;
    width: 100%;
  }

  .section-title-sm { font-size: 1.2rem; color: var(--gray-400); margin-bottom: 1.5rem; }
  
  .section-desc { 
    text-align: left; 
    margin-bottom: 1rem; 
    color: var(--gray-400); 
    max-width: 600px; 
    line-height: 1.6; 
  }

  /* --- Background Section --- */
  .timeline { 
    display: grid; 
    gap: 0.5rem; /* 学歴と職歴の隙間 */
    margin-top: 0; 
  }
  @media (min-width: 768px) { .timeline { grid-template-columns: 1fr 1fr; gap: 1rem; } }

  .background-card {
    border: 1px solid var(--gray-800); 
    padding: 1.25rem; /* カード内パディング */
    border-radius: 1rem; 
    background: var(--gray-999); 
    height: 100%; 
    display: flex;
    flex-direction: column;
  }

  .card-heading { 
    color: var(--accent);     
    margin-bottom: 0.75rem; 
    border-bottom: 1px solid var(--gray-700); 
    padding-bottom: 0.5rem; 
    font-size: 1.2rem; 
    letter-spacing: 0.05em; 
  }

  .timeline-list { list-style: none; padding: 0; }
  .timeline-list li { margin-bottom: 1rem; }
  .timeline-list li:last-child { margin-bottom: 0; }

  .year { display: block; font-size: 0.85rem; color: var(--gray-500); margin-bottom: 0.2rem; font-family: var(--font-mono); }
  .content strong { display: block; font-size: 1.1rem; margin-bottom: 0.3rem; color: var(--gray-100); }
  .degree-badge { font-size: 0.75em; background: var(--gray-800); padding: 0.1rem 0.4rem; border-radius: 4px; margin-left: 0.3rem; vertical-align: middle; color: var(--gray-300); font-weight: normal; }
  .content p { font-size: 0.95rem; color: var(--gray-400); line-height: 1.6; margin-bottom: 0.5rem; }

  /* --- Link Styles --- */
  .edu-links { margin-top: 0.5rem; display: flex; gap: 1rem; flex-wrap: wrap; }
  .text-link { font-size: 0.85rem; color: var(--accent); text-decoration: none; display: inline-flex; align-items: center; gap: 0.3rem; transition: opacity 0.2s; }
  .text-link:hover { opacity: 0.8; text-decoration: underline; }
  .text-link .icon { font-size: 0.8rem; }
  
  /* カード内リンクの位置調整 */
  .related-link-wrapper { margin-top: 0.5rem; margin-bottom: auto; }

  /* --- Project Cards --- */
  .projects-grid { 
    display: grid; 
    gap: 1rem; /* プロジェクトカード間の隙間 */
    align-items: start;
  }
  
  .card-link { text-decoration: none; color: inherit; display: block; height: 100%; }
  
  .project-card { 
    border: 1px solid var(--gray-800); 
    padding: 1.25rem; 
    border-radius: 1rem; 
    background: var(--gray-999); 
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    height: auto; 
    display: flex; 
    flex-direction: column; 
    justify-content: flex-start;
    gap: 0;
    position: relative; 
  }

  .card-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 1rem; flex-grow: 0; }
  .card-header h3 { font-size: 1.4rem; color: var(--gray-100); margin: 0; transition: color 0.3s ease; }
  
  .project-summary { flex-grow: 0; margin-bottom: 0.75rem; color: var(--gray-300); line-height: 1.6; }
  .card-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 1rem; flex-grow: 0; gap: 1rem; }
  .tech-tag { color: var(--accent); font-size: 0.85rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.05em; }
  .tech-stack { font-size: 0.85rem; color: var(--gray-500); font-family: var(--font-mono); }
  .arrow-icon { color: var(--accent); font-weight: bold; transform: translateX(0); transition: all 0.3s ease; }

  /* --- Device Behaviors --- */
  @media (hover: hover) {
    .project-card:hover { 
      border-color: var(--accent); 
      transform: translateY(-5px); 
      background: rgba(56, 189, 248, 0.1); 
      box-shadow: 0 12px 40px -12px rgba(56, 189, 248, 0.5);
      cursor: pointer; 
    }
    .arrow-icon { opacity: 0.5; }
    .card-link:hover .arrow-icon { opacity: 1; transform: translateX(5px); text-shadow: 0 0 8px var(--accent); }
    .card-link:hover h3 { color: var(--accent); }
  }

  @media (hover: none) {
    .arrow-icon { opacity: 1; }
    .card-link:active .project-card {
      background: rgba(56, 189, 248, 0.1);
      border-color: var(--accent);
      transform: scale(0.98);
    }
    .card-link:active h3 { color: var(--accent); }
  }

  /* Interests */
  .interests-cloud { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; max-width: 700px; margin: 0 auto; }
  .interests-cloud span { color: var(--gray-200); font-weight: 500; background: rgba(255,255,255,0.05); padding: 0.5rem 1rem; border-radius: 99px; font-size: 0.95rem; }
</style>
