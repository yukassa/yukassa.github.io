---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillsGrid from '../components/SkillsGrid.astro';
import ContactBanner from '../components/ContactBanner.astro';

// 1. Projects コレクションの取得とソート
// data/projects/*.json からデータを取得し、orderプロパティ順に並べ替えます
const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => {
  return (a.data.order ?? 99) - (b.data.order ?? 99);
});
// 上位3件をピックアップし、.data (中身) だけを取り出す
const spotlightProjects = sortedProjects.slice(0, 3).map(p => p.data);

// 2. Skills コレクションの取得とソート
// data/skills/*.json からデータを取得し、orderプロパティ順に並べ替えます
const allSkills = await getCollection('skills');
const sortedSkills = allSkills
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map(item => item.data);
// トップページに表示する数（ここでは上位8件）
const spotlightSkills = sortedSkills.slice(0, 8);

// Heroセクションのデータ定義
const heroProps = {
  title: "UI と実装の橋渡しで、プロダクトを最速で届ける",
  subtitle: "Creative Developer / DesignOps",
  description: "デザインシステム構築とフロントエンド実装を軸に、チームが継続的に価値を届けられる仕組みを整備します。",
  primaryCta: { label: "Projects", href: "/projects" },
  secondaryCta: { label: "About Me", href: "/about" },
  heroSkills: [
    'Design Systems',
    'Frontend Architecture',
    'Accessibility',
    'Data Visualization'
  ]
};
---

<BaseLayout title="Home — yukassa" description="クリエイティブデベロッパー yukassa のポートフォリオサイト。">
  <Hero {...heroProps} />

  <section class="section container">
    <header class="section-header">
      <h2>Selected Projects</h2>
      <p>ユーザーとビジネスの両面をつなぐ主要なプロジェクト。</p>
    </header>
    
    <div class="projects-grid">
      {spotlightProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
    
    <div class="view-all">
      <a href="/projects">View all projects →</a>
    </div>
  </section>

  <section class="section container">
    <header class="section-header">
      <h2>Core Technologies</h2>
      <p>プロダクト開発で使用する主要な技術スタック。</p>
    </header>
    <SkillsGrid skills={spotlightSkills} />
  </section>

  <ContactBanner 
    title="Ready to collaborate?" 
    description="プロジェクトのご相談や、技術的なディスカッションなど、お気軽にご連絡ください。"
    primaryCta={{ label: "Contact Me", href: "mailto:hello@example.com" }}
  />
</BaseLayout>

<style>
  /* ページ固有の余白調整 */
  .section {
    padding-top: clamp(2rem, 5vw, 4rem);
    padding-bottom: clamp(2rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .section-header {
    max-width: 600px;
  }

  .section-header h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    margin: 0 0 0.5rem;
  }

  .section-header p {
    color: var(--muted);
    font-size: 1.05rem;
    margin: 0;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .view-all {
    text-align: right;
  }

  .view-all a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }

  .view-all a:hover {
    text-decoration: underline;
  }
</style>
