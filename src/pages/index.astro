---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, getCollection } from 'astro:content'; // getCollection を追加

// 1. Resumeデータ (Basics, Education, Work) は JSON から取得
const resumeEntry = await getEntry('resume', 'resume');
const data = resumeEntry?.data || {};

const education = data.education || [];
const workHistory = data.work || [];

// 2. プロジェクト (Key Projects) は MDX から取得
// コレクション 'projects' を取得し、frontmatter の order 順にソート
const allProjects = await getCollection('projects');
const keyProjects = allProjects
  .filter((project) => project.data.projectType !== 'personal')
  .sort((a, b) => {
    return (a.data.order || 99) - (b.data.order || 99);
  });

// 3. Personal Works（個人研究）も同様に MDX から取得
const personalWorks = allProjects
  .filter((project) => project.data.projectType === 'personal')
  .sort((a, b) => {
    return (a.data.order || 99) - (b.data.order || 99);
  });
---

<BaseLayout title="Portfolio" description={data.basics?.summary}>
  <div class="main-stack">
    
    {/* 1. Hero: 何者かを端的に */}
    <header class="hero wrapper">
      <h1 class="hero-title">
        Backend Engineer <br/>
        <span class="text-accent">x Physics Background</span>
      </h1>
      <p class="hero-lead">
        {data.basics?.summary}
      </p>
    </header>

    {/* 2. Background: 学歴・職歴 */}
    <section class="section wrapper">
      <h2 class="section-title">Background</h2>
      <div class="timeline">
        
        {/* Academic Card */}
        <div class="background-card">
          <h3 class="card-heading">Academic</h3>
          <ul class="timeline-list">
            {education.map((edu) => (
              <li>
                <span class="year">{edu.period}</span>
                <div class="content">
                  <strong>{edu.area} <span class="degree-badge">{edu.studyType}</span></strong>
                  <p>{edu.summary}</p>
                  
                  {/* 学歴のリンク表示 */}
                  {edu.links && edu.links.length > 0 && (
                    <div class="edu-links">
                      {edu.links.map(link => (
                        <a href={link.url} target="_blank" rel="noopener noreferrer" class="text-link">
                          <span class="icon">📎</span> {link.label}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>

        {/* Career Card */}
        <div class="background-card">
          <h3 class="card-heading">Career</h3>
          <ul class="timeline-list">
            {workHistory.map((job) => (
              <li>
                <span class="year">{job.period}</span>
                <div class="content">
                  <strong>{job.position}</strong>
                  <p>{job.summary}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </section>

    {/* 3. Selected Works: MDX から取得して表示 */}
    <section class="section wrapper">
      <h2 id="selected-works" class="section-title">Selected Works</h2>
      <p class="section-desc">バックエンドエンジニアとしての主要なシステム開発・データ分析の実績です。</p>
      
      <div id="selected-works" class="projects-grid">
        {keyProjects.map((project) => {
          // MDXの場合、project.data にフロントマターが入っています
          // Content Layer API では slug ではなく project.id でアクセスします
          
          return (
            <article class="project-card">
              <header class="card-header">
                <h3>{project.data.name}</h3>
                <span class="tech-tag">{project.data.architecture}</span>
              </header>
              <p class="project-summary">{project.data.summary}</p>
              
              {/* フロントマターに details (箇条書きリスト) がある場合のみ表示 */}
              <ul class="project-points">
                {project.data.details?.slice(0, 2).map(d => <li>{d}</li>)}
                
                {/* Related Link */}
                {project.data.relatedLink && (
                  <li class="related-link-item">
                    <a href={project.data.relatedLink.url} target="_blank" rel="noopener noreferrer" class="text-link">
                      <span class="icon">📎</span> {project.data.relatedLink.label}
                    </a>
                  </li>
                )}
              </ul>
              
              <div class="card-footer">
                 <span class="tech-stack">{project.data.technologies?.join(', ')}</span>
                 {/* リンク先を MDX の slug に基づくURLに変更 */}
                 <a href={`/projects/${project.id}`} class="detail-link">
                  <span class="link-text">詳細を見る</span> <span class="arrow-icon">→</span>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    {/* 3.5 Personal Works: 個人研究プロジェクト（MDX, projectType: personal） */}
    <section class="section wrapper">
      <h2 id="personal-works" class="section-title">Personal Works</h2>
      <p class="section-desc">物理学のバックグラウンドを活かした、個人研究・技術検証の記録です。</p>

      <div class="projects-grid">
        {personalWorks.map((project) => (
          <article class="project-card">
            <header class="card-header">
              <h3>{project.data.name}</h3>
              <span class="tech-tag">{project.data.architecture}</span>
            </header>
            <p class="project-summary">{project.data.summary}</p>

            {/* フロントマターに details (箇条書きリスト) がある場合のみ表示 */}
            <ul class="project-points">
              {project.data.details?.slice(0, 2).map(d => <li>{d}</li>)}

              {/* Related Link */}
              {project.data.relatedLink && (
                <li class="related-link-item">
                  <a href={project.data.relatedLink.url} target="_blank" rel="noopener noreferrer" class="text-link">
                    <span class="icon">📎</span> {project.data.relatedLink.label}
                  </a>
                </li>
              )}
            </ul>

            <div class="card-footer">
               <span class="tech-stack">{project.data.technologies?.join(', ')}</span>
               <a href={`/projects/${project.id}`} class="detail-link">
                <span class="link-text">詳細を見る</span> <span class="arrow-icon">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  /* --- Layout & Spacing --- */
  .main-stack {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .main-stack {
      gap: 3rem;
    }
  }

  .wrapper {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 5vw, 4rem);
  }
  
  .text-accent { color: var(--accent); }

  /* --- Hero --- */
  .hero { text-align: center; padding: 1rem 0; }
  .hero-title { font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.1; margin-bottom: 1rem; color: var(--gray-0); }
  
  .hero-lead { 
    color: var(--gray-300);
    width: min(92%, 600px);
    max-width: 580px;
    margin: 0 auto 1.5rem;
    font-size: 1.05rem;
    line-height: 1.6;
    padding: 0;
  }
  @media (min-width: 768px) {
    .hero-lead {
      width: 100%;       
      max-width: 800px;  
    }
  }

  /* --- Section Title --- */
  .section-title { 
    font-size: 2rem; 
    margin-bottom: 0.5rem; 
    color: var(--gray-0);
    text-align: left; 
    border-top: 1px solid var(--gray-600);
    padding-top: 0.75rem;
    width: 100%;
    scroll-margin-top: 100px;
  }

  .section-title-sm { font-size: 1.2rem; color: var(--gray-400); margin-bottom: 1.5rem; }
  
  .section-desc { 
    text-align: left; 
    margin-bottom: 1rem; 
    color: var(--gray-400); 
    max-width: 600px; 
    line-height: 1.6; 
  }

  /* --- Background Section (Timeline) --- */
  .timeline { 
    display: grid; 
    gap: 0.5rem; 
    margin-top: 0; 
  }
  @media (min-width: 768px) { .timeline { grid-template-columns: 1fr 1fr; gap: 1rem; } }

  .background-card {
    border: 1px solid var(--gray-800); 
    padding: 1.25rem;
    border-radius: 1rem; 
    background: var(--gray-999); 
    height: 100%; 
    display: flex;
    flex-direction: column;
  }

  .card-heading { 
    color: var(--accent);     
    margin-bottom: 0.75rem; 
    border-bottom: 1px solid var(--gray-700); 
    padding-bottom: 0.5rem; 
    font-size: 1.2rem; 
    letter-spacing: 0.05em; 
  }

  .timeline-list { list-style: none; padding: 0; }
  .timeline-list li { margin-bottom: 1rem; }
  .timeline-list li:last-child { margin-bottom: 0; }

  .year { display: block; font-size: 0.85rem; color: var(--gray-500); margin-bottom: 0.2rem; font-family: var(--font-mono); }
  .content strong { display: block; font-size: 1.1rem; margin-bottom: 0.3rem; color: var(--gray-100); }
  .degree-badge { font-size: 0.75em; background: var(--gray-800); padding: 0.1rem 0.4rem; border-radius: 4px; margin-left: 0.3rem; vertical-align: middle; color: var(--gray-300); font-weight: normal; }
  .content p { font-size: 0.95rem; color: var(--gray-400); line-height: 1.6; margin-bottom: 0.5rem; }

  .edu-links { margin-top: 0.5rem; display: flex; gap: 1rem; flex-wrap: wrap; }
  .text-link { font-size: 0.85rem; color: var(--accent); text-decoration: none; display: inline-flex; align-items: center; gap: 0.3rem; transition: opacity 0.2s; }
  .text-link:hover { opacity: 0.8; text-decoration: underline; }
  .text-link .icon { font-size: 0.8rem; }
  .related-link-item { list-style: none; margin-top: 0.5rem; margin-left: -1.2rem; }

  /* --- Project Cards --- */
  .projects-grid { 
    display: grid; 
    gap: 1.5rem;
    align-items: start;
  }
  
  .project-card { 
    border: 1px solid var(--border);
    padding: 1.5rem;
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    height: auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0;
    position: relative;
    backdrop-filter: blur(8px);

     /* 1. GPUレイヤーの独立化: 
       要素を独自のレイヤーに切り出すことで、スクロール時の再描画コストを下げる */
    transform: translateZ(0); 
    
    /* 2. ブラウザへのヒント: 
       「この要素は変化する可能性がある」と伝え、事前に最適化させる */
    will-change: transform, opacity;

    /* 3. コンテンツの可視性強制 (念のため):
       ブラウザの自動最適化(content-visibility: auto)による遅延レンダリングを防ぐ */
    content-visibility: visible; 

    /* 4. 背面描画の最適化:
       すりガラス効果の計算を要素の境界ボックス内に限定 */
    -webkit-backdrop-filter: blur(8px); /* Safari対応 */
  }

  .card-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 1rem; flex-grow: 0; }
  .card-header h3 { font-size: 1.4rem; color: var(--gray-100); margin: 0; transition: color 0.3s ease; }
  
  .project-summary { flex-grow: 0; margin-bottom: 0.75rem; color: var(--gray-300); line-height: 1.6; }
  .project-points { flex-grow: 0; padding-left: 1.2rem; margin-bottom: 0; margin-top: 0; color: var(--gray-400); list-style-type: square; line-height: 1.5; }
  .project-points li { margin-bottom: 0.3rem; }
  
  .card-footer { 
    display: flex; 
    align-items: center;  /* 下揃えにしたい場合はflex-end */
    margin-top: 1rem; 
    flex-grow: 0; 
    gap: 1rem; 
    flex-wrap: wrap; /* スマホでの崩れ防止 */
  }

  .tech-tag { color: var(--accent); font-size: 0.85rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.05em; }
  .tech-stack { font-size: 0.85rem; color: var(--gray-500); font-family: var(--font-mono); }
  
  .detail-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: bold;
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    z-index: 10;
    margin-left: auto;
  }

  .arrow-icon { transition: transform 0.3s ease; }

  /* --- Device Behaviors (PC vs Mobile) --- */
  
  /* 1. PC (マウス操作ができる環境) の挙動 */
  @media (hover: hover) {
    /* "Stretched Link": リンクをカード全体に広げる */
    .detail-link::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 1;
      cursor: pointer;
    }

    /* ホバー時のカード挙動 */
    .project-card:hover { 
      border-color: var(--accent); 
      transform: translateY(-4px); 
      background: var(--surface-raised);
      box-shadow: 0 12px 40px -8px rgba(0, 0, 0, 0.4);
    }
    
    .project-card:hover .arrow-icon { 
      transform: translateX(5px); 
    }
    .project-card:hover h3 { color: var(--accent); }
    
    .arrow-icon { opacity: 0.5; }
    .project-card:hover .arrow-icon { opacity: 1; }
  }

  /* 2. スマホ (タッチ操作のみの環境) の挙動 */
  @media (hover: none) {
    /* Stretched Link を無効化 */
    .detail-link::after { content: none; }
    
    /* リンクをタップしやすいスタイルに */
    .detail-link {
      text-decoration: none; 
      padding: 0.5rem 0;
    }
    
    /* 文字部分だけに下線（ボーダー）を引く */
    .link-text {
      border-bottom: 1px solid var(--accent); /* アクセントカラーの下線 */
      padding-bottom: 2px; /* 文字と線の間隔 */
    }
    
    /* 矢印は常時表示 */
    .arrow-icon { opacity: 1; color: inherit; margin-left: 0.5rem; }
    
    /* タップ時のフィードバック */
    .detail-link:active {
      opacity: 0.7;
    }
  }
</style>
