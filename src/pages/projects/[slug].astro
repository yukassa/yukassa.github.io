---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// 1. 生成するページのパスを定義する（必須）
export async function getStaticPaths() {
  // 'projects' コレクションの全ファイルを取得
  const projects = await getCollection('projects');

  // 各プロジェクトごとに、その slug (ファイル名) をパスとして設定
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

// 2. ページ生成時のデータ受け取り
const { project } = Astro.props;
const { Content } = await project.render(); // MDXの中身をレンダリング
---

<BaseLayout title={`${project.data.name} | Portfolio`} description={project.data.summary}>
  <div class="wrapper project-detail">
    <a href="/#key-projects" class="back-link">← Back to Portfolio</a>
    
    <header class="detail-header">
      <span class="architecture">{project.data.architecture}</span>
      <h1>{project.data.name}</h1>
      <div class="tech-stack">
        {project.data.technologies.map((tech) => (
          <span class="tech-pill">{tech}</span>
        ))}
      </div>
    </header>

    <div class="content-body">
      <Content />
    </div>
  </div>
</BaseLayout>

<style>
  .wrapper { max-width: 800px; margin: 0 auto; padding: 3rem 1.5rem; }
  .back-link { display: inline-block; margin-bottom: 2rem; color: var(--accent); text-decoration: none; font-weight: bold; }
  .detail-header { margin-bottom: 3rem; border-bottom: 1px solid var(--gray-800); padding-bottom: 2rem; }
  .architecture { color: var(--accent); font-weight: bold; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 0.5rem; }
  h1 { font-size: 2.5rem; margin-bottom: 1.5rem; color: var(--gray-0); line-height: 1.2; }
  .tech-stack { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .tech-pill { background: rgba(255,255,255,0.1); padding: 0.3rem 0.8rem; border-radius: 99px; font-size: 0.85rem; color: var(--gray-200); }
  
  /* MDXコンテンツ内のスタイル */
  .content-body { line-height: 1.8; color: var(--gray-300); }
  /* MDX内の見出しや段落のスタイルは global.css かここで調整 */
  .content-body :global(h2) { font-size: 1.8rem; color: var(--gray-100); margin-top: 3rem; margin-bottom: 1rem; }
  .content-body :global(h3) { font-size: 1.4rem; color: var(--gray-200); margin-top: 2rem; margin-bottom: 0.8rem; }
  .content-body :global(p) { margin-bottom: 1.5rem; }
  .content-body :global(ul) { margin-bottom: 1.5rem; padding-left: 1.5rem; }
  .content-body :global(li) { margin-bottom: 0.5rem; }
</style>
