---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
---

<BaseLayout title={`${project.data.name} — Project Details`} description={project.data.summary}>
  {/* 数式表示用のスタイルシート（Katex）を読み込み */}
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
    integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV"
    crossorigin="anonymous"
    slot="head" 
  />

  <article class="project-detail">
    <header class="hero-header wrapper">
      <div class="nav-back">
        <a href="/#key-projects">← Back to Portfolio</a>
      </div>
      
      <div class="header-content">
        {project.data.architecture && (
          <span class="architecture-badge">{project.data.architecture}</span>
        )}
        <h1 class="project-title">{project.data.name}</h1>
        <div class="tech-stack-hero">
          {(project.data.technologies || []).map((tech) => (
            <span class="tech-pill">{tech}</span>
          ))}
        </div>
      </div>
    </header>

    <div class="content-wrapper wrapper">
      <div class="main-column">
        {/* OverviewなどはMDXの中に書くので、ここでは Content を展開するだけ */}
        <div class="mdx-content">
          <Content />
        </div>
        
        {/* リンクがあれば最下部にも表示*/}
        {project.data.relatedLink && (
           <div class="project-external-link">
              <a href={project.data.relatedLink.url} target="_blank" class="text-link">
                <span class="icon">📎</span> {project.data.relatedLink.label}
              </a>
           </div>
        )}
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .wrapper {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ヘッダー */
  .hero-header {
    padding-top: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 3rem;
  }

  .nav-back a {
    display: inline-block;
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    margin-bottom: 2rem;
    font-size: 0.95rem;
    transition: transform 0.2s;
  }
  .nav-back a:hover {
    transform: translateX(-4px);
  }

  .architecture-badge {
    display: inline-block;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .project-title {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
    color: var(--gray-0);
    margin: 0 0 1.5rem 0;
  }

  .tech-stack-hero {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .tech-pill {
    font-size: 0.85rem;
    padding: 0.3rem 0.8rem;
    border-radius: 99px;
    background: rgba(255,255,255,0.05);
    color: var(--gray-300);
    border: 1px solid var(--border);
  }

  /* コンテンツ */
  .content-section {
    margin-bottom: 3rem;
  }

  .content-section h2 {
    font-size: 1.5rem;
    color: var(--gray-100);
    margin-bottom: 1.2rem;
    border-left: 4px solid var(--accent);
    padding-left: 1rem;
  }

  .summary-text {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--gray-300);
  }
  
  /* ★追加: リンク用のコンテナ */
  .project-external-link {
    margin-top: 1rem;
  }

  /* ★追加: リンクのスタイル（index.astroと統一） */
  .text-link {
    font-size: 0.9rem; /* 少しだけ大きく */
    color: var(--accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: opacity 0.2s;
  }
  .text-link:hover { opacity: 0.8; text-decoration: underline; }
  .text-link .icon { font-size: 0.85rem; }

  .details-list {
    list-style: none;
    padding: 0;
  }

  .details-list li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 1.2rem;
    line-height: 1.7;
    color: var(--gray-300);
  }

  .details-list li::before {
    content: "▹";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: bold;
  }

  .mdx-content {
    line-height: 1.8;
    color: var(--gray-300);
  }
  .mdx-content h2 {
    font-size: 1.5rem;
    color: var(--gray-100);
    margin-top: 3rem;
    margin-bottom: 1.2rem;
    border-left: 4px solid var(--accent);
    padding-left: 1rem;
  }
  .mdx-content p {
    margin-bottom: 1.5rem;
  }
</style>
