---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const resumeEntry = await getEntry('resume', 'resume');
// projects ではなく productSystems を取得
const rawProjects = resumeEntry?.data?.productSystems || [];

// Slug をここで生成して、データを整形する
const projects = rawProjects.map(p => ({
  ...p,
  slug: p.name.toLowerCase().replace(/_/g, '-').replace(/\s+/g, '-'),
  title: p.name,
  description: p.summary,
  role: [p.architecture], // architecture を役割の代わりに表示
  stack: p.technologies,
  highlights: p.details
}));
---

<BaseLayout title="Projects — yukassa" description="システム開発の実績一覧">
  <article class="page">
    <header class="page__hero container">
      <p class="page__eyebrow">Projects</p>
      <h1>Product Systems</h1>
      <p class="page__lead">
        大規模なECシステムやサーバレスアーキテクチャなど、
        技術的な詳細と成果をまとめたポートフォリオです。
      </p>
    </header>

    <div class="projects">
      {projects.map((project, index) => (
        <section id={project.slug} class="project container">
          <div class="project__meta">
            <span class="project__index">{String(index + 1).padStart(2, '0')}</span>
            <p class="project__tagline">{project.architecture}</p>
          </div>
          <div class="project__body">
            <div class="project__content">
              <h2>
                <a href={`/projects/${project.slug}`} class="project-title-link">
                  {project.title}
                </a>
              </h2>
              <p class="project__summary">{project.description}</p>
              
              <div class="project__lists">
                <div>
                  <h3>詳細</h3>
                  <ul>
                    {project.highlights?.slice(0, 2).map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="project__footer">
                <div class="project__stack">
                  {project.stack?.slice(0, 5).map((tech) => (
                    <span>{tech}</span>
                  ))}
                  {project.stack?.length > 5 && <span>+More</span>}
                </div>
                <div class="project__links">
                   <a href={`/projects/${project.slug}`}>View Details →</a>
                </div>
              </div>
            </div>
          </div>
        </section>
      ))}
    </div>
  </article>
</BaseLayout>

<style>
  /* 前回のCSSスタイルをそのまま利用可能です */
  /* タイトルをリンクにするスタイルだけ追加 */
  .project-title-link {
    text-decoration: none;
    color: inherit;
    transition: color 0.2s;
  }
  .project-title-link:hover {
    color: var(--accent);
  }
  
  /* 前回のCSSスタイル... */
  .page { display: flex; flex-direction: column; gap: 3rem; }
  .page__hero { padding: 3rem 1.5rem; background: linear-gradient(150deg, #12204c, #080e26); color: #fff; border-radius: 2rem; margin: 0 1.5rem; }
  .page__hero h1 { font-size: 2.5rem; margin: 0.5rem 0; }
  .page__lead { color: #a5b4fc; }
  .projects { display: grid; gap: 2rem; padding: 0 1.5rem; }
  .project { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 1.5rem; padding: 2rem; color: #fff; }
  .project__meta { margin-bottom: 1rem; color: #a5b4fc; font-weight: bold; }
  .project__index { font-size: 1.5rem; margin-right: 1rem; color: var(--accent); }
  .project__stack span { display: inline-block; background: rgba(255,255,255,0.1); padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.85rem; margin-right: 0.5rem; margin-bottom: 0.5rem; }
  .project__links a { color: var(--accent); text-decoration: none; font-weight: bold; }
  .project__lists ul { padding-left: 1.2rem; color: #cbd5e1; }
</style>
